{
  "name": "wood_slab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\"Name='node.exe'\\\" | Where-Object { $_.CommandLine -like '*admin_and_manager*node_modules*next*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; if (Test-Path '.next\\dev\\lock') { Remove-Item -Path '.next\\dev\\lock' -Force -ErrorAction SilentlyContinue }; exit 0\"",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@supabase/auth-helpers-nextjs": "^0.14.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.108.1",
    "@thesvg/react": "^3.2.21",
    "@xenova/transformers": "^2.17.2",
    "browser-image-compression": "^2.0.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
