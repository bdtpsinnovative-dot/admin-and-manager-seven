# ==============================================================================
# 1. SUPABASE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# 2. SUPABASE STORAGE
# ==============================================================================
STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public/product-images
NEXT_PUBLIC_STORAGE_URL=https://your-project.supabase.co/storage/v1/object/public/product-images

# ==============================================================================
# 3. CLOUDFLARE R2
# ==============================================================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hr-immage
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ==============================================================================
# 4. MOBILE RFID PROXY
# ==============================================================================
MOBILE_RFID_UPSTREAM_BASE_URL=https://your-project.supabase.co
MOBILE_RFID_API_KEY=your-supabase-anon-key
MOBILE_RFID_TIMEOUT_MS=15000
